# Temporal Orchestration
# For Local Dev:
# TEMPORAL_ADDRESS="localhost:7233"
# TEMPORAL_NAMESPACE="default"

# For Temporal Cloud:
TEMPORAL_ADDRESS="quickstart-xxxx.xxxx.tmprl.cloud:7233"
TEMPORAL_NAMESPACE="quickstart-xxxx.xxxx"
TEMPORAL_API_KEY="" # Required for Temporal Cloud
TASK_QUEUE="tabsitter-watch-queue"

# TabSitter Cloud API
API_URL="http://localhost:3000"

# Local Ollama AI (No cloud inference)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma2"

# Browserbase / Stagehand (Headless Browsing)
# Leave empty for local headless Chromium via Stagehand
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""
